# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser; never put secrets
# (payment secret keys, storage keys) in this frontend — they belong to the backend (spec §9).

# Base URL of the Amanah backend API. `npm run mock:api` serves a mock on port 4000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Public URL of this frontend (used for absolute links and CORS on the mock API).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public contact email shown on the landing page ("Talk to the team", organisation sign-up).
# Leave empty to hide those contact buttons.
NEXT_PUBLIC_CONTACT_EMAIL=
